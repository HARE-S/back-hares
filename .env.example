# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (BE-02)
# Copia este archivo a .env en tu entorno local para configurar la aplicación.
# NO INCLUYAS CONTRASEÑAS REALES EN ESTE ARCHIVO.
# ==============================================================================

# --- Imágenes del stack ---
# database y proxy usan estas variables para la imagen; backend y frontend
# están hardcodeados en sus Dockerfiles con un comentario indicando dónde
# sustituir por las dhi.io correspondientes.
POSTGRES_IMAGE=postgres:18-alpine
# POSTGRES_IMAGE=dhi.io/postgresql:18.6-alpine3.24-fips
NGINX_IMAGE=nginx:1.31.5-alpine
# NGINX_IMAGE=dhi.io/nginx:1.31.5-alpine3.24-fips

# Entorno de la aplicación (development | testing | production)
APP_ENV=development

# Clave secreta para la firma de cookies de sesión (Mínimo 32 caracteres en producción)
SECRET_KEY=dev-secret-key-hares-penascal-2026-min-32-chars

# Autenticación simulada en desarrollo (true | false)
# ALERTA: Nunca activar en producción (APP_ENV=production)
DEV_AUTH_BYPASS=true

# Configuración de PostgreSQL
# Ojo: dentro del stack Docker el host es SIEMPRE "database" (nombre de servicio).
# El override de desarrollo mapea el puerto 5433 del host al 5432 del contenedor.
POSTGRES_USER=hares_user
POSTGRES_PASSWORD=hares_pass
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=hares_db

# URL completa de la base de datos PostgreSQL (sobrescribe los valores individuales si se define)
DATABASE_URL=postgresql://hares_user:hares_pass@database:5432/hares_db

# Base de datos PostgreSQL para pruebas automatizadas
# Ojo: el host es "db-test", el nombre del servicio definido en docker-compose.override.yml
TEST_DATABASE_URL=postgresql://hares_user:hares_pass@db-test:5432/hares_test

# Configuración de CORS en desarrollo (lista separada por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tipo de persistencia de sesión en servidor (sqlalchemy | redis | filesystem)
SESSION_TYPE=sqlalchemy

# Configuración de pgAdmin (solo herramienta de administración, perfil tools)
PGADMIN_EMAIL=admin@penascal.com
PGADMIN_PASSWORD=
