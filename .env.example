# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO DEL BACKEND (BE-02)
# Copia este archivo a .env en tu entorno local para configurar la aplicación.
# NO INCLUYAS CONTRASEÑAS REALES EN ESTE ARCHIVO: los valores sensibles van
# vacíos o con un marcador "CHANGE_ME". El .env real se rellena en local y NO
# se versiona.
#
# IMPORTANTE: en el stack Docker (ver ../infra-hares/.env.example) estas mismas
# variables las inyecta el contenedor desde el compose; aquí están documentadas
# las que la aplicación lee directamente.
# ==============================================================================

# Entorno de la aplicación (development | testing | production)
APP_ENV=development

# Clave secreta para la firma de cookies de sesión (Mínimo 32 caracteres en producción)
# Generar con: openssl rand -hex 32
SECRET_KEY=

# Autenticación simulada en desarrollo (true | false)
# ALERTA: Nunca activar en producción (APP_ENV=production)
DEV_AUTH_BYPASS=true

# Configuración de PostgreSQL
# Ojo: dentro del stack Docker el host es SIEMPRE "database" (nombre de servicio).
# El override de desarrollo en infra-hares mapea el puerto 5433 del host al 5432 del contenedor.
POSTGRES_USER=hares_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=hares_db

# URL completa de la base de datos PostgreSQL (sobrescribe los valores individuales si se define)
DATABASE_URL=postgresql://hares_user:CHANGE_ME@database:5432/hares_db

# Base de datos PostgreSQL para pruebas automatizadas
# Ojo: el host es "db-test", el nombre del servicio definido en infra-hares/docker-compose.override.yml
TEST_DATABASE_URL=postgresql://test_user:test_password@db-test:5432/hares_test

# Configuración de CORS en desarrollo (lista separada por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tipo de persistencia de sesión en servidor (sqlalchemy | redis | filesystem)
SESSION_TYPE=sqlalchemy

# Autenticación OIDC con Google (US-51 / EP-12)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/callback
ALLOWED_HD=grupopenascal.com